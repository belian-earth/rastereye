{
  "name": "rastereye",
  "displayName": "RasterEye",
  "description": "Quick GeoTIFF viewer with colormaps, false color composites, and basemap selection",
  "version": "0.3.3",
  "publisher": "belian-earth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/belian-earth/rastereye.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "rastereye.geotiffViewer",
        "displayName": "RasterEye GeoTIFF Viewer",
        "selector": [
          {
            "filenamePattern": "*.tif"
          },
          {
            "filenamePattern": "*.tiff"
          },
          {
            "filenamePattern": "*.TIF"
          },
          {
            "filenamePattern": "*.TIFF"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "rastereye.open",
        "title": "Open in RasterEye"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "rastereye.open",
          "when": "resourceFilename =~ /\\.(tif|tiff)$/i",
          "group": "navigation@99"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "build": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "vsce:package": "vsce package --no-dependencies",
    "package": "npm run vsce:package",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/geo-layers": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/maplibre": "^9.4.1",
    "@deck.gl/mesh-layers": "^9.4.1",
    "@developmentseed/deck.gl-geotiff": "^0.10.0",
    "@developmentseed/deck.gl-raster": "^0.10.0",
    "@developmentseed/geotiff": "^0.10.0",
    "@developmentseed/morecantile": "^0.10.0",
    "@developmentseed/proj": "^0.10.0",
    "@luma.gl/core": "^9.4.2",
    "@luma.gl/shadertools": "^9.4.2",
    "@luma.gl/webgl": "^9.4.2",
    "geotiff": "^3.0.5",
    "maplibre-gl": "^6.19.0",
    "proj4": "^2.23.0",
    "proj4-list": "^1.0.4"
  },
  "files": [
    "dist/extension.js",
    "dist/webview.js",
    "dist/webview.css",
    "dist/viewer.html",
    "README.md",
    "LICENSE"
  ]
}
